    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.99.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.2",
    "@tanstack/react-query": "^5.90.7",
    "@types/bs58": "^4.0.4",
    "bs58": "^6.0.0",
